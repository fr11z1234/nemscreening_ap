# Kopier til .env.local og udfyld. .env.local er gitignoreret.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://mwityvqavrqxqaunvtdg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Hemmelig nogle. Bruges KUN til at oprette logins fra /brugere, og kun efter at
# server-handlingen har tjekket at den indloggede er admin — noglen gar uden om
# RLS, og auth deles med nemscreening.dk.
#
# MA ALDRIG faa NEXT_PUBLIC_-praefiks. I Vercel skal den vaere markeret
# Sensitive; det er netop den slags variabel markeringen findes til.
#
# Uden den virker resten af appen, men /brugere kan ikke oprette nogen.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Datafordeleren (BBR GraphQL) -------------------------------------------
# API-nogle fra et IT-system i Datafordelerens administration.
# Bemaerk: BBR GraphQL bruger API-nogle, mens den gamle REST-tjeneste bruger en
# tjenestebruger med username/password. Vi bruger GraphQL, sa der er ingen
# brugernavn — kun denne nogle.
#
# MA ALDRIG faa NEXT_PUBLIC_-praefiks: den ville ligge i browserens bundle.
DATAFORDELER_API_KEY=
